{
	"name": "note-improver",
	"version": "1.1.1",
	"description": "Improve active Obsidian notes with reviewed AI edits using Groq or local Ollama.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"check:release": "node validate-release.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"ai",
		"markdown",
		"groq",
		"ollama"
	],
	"author": "Thomas M.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nuuye/obsidian-agent-plugin.git"
	},
	"bugs": {
		"url": "https://github.com/nuuye/obsidian-agent-plugin/issues"
	},
	"homepage": "https://github.com/nuuye/obsidian-agent-plugin#readme",
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
