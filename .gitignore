# vscode
.vscode 

# Intellij
*.iml
.idea

# Editor swap files
*.swp

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# Obsidian stores plugin settings here at runtime. It may contain secrets in
# older installations and must never be committed.
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store
